# ============================================================================
# Wardrobe Environment Configuration
# ============================================================================
# Copy this file to .env and update the values for your environment
# For production, generate secure secrets: openssl rand -hex 32
# ============================================================================

# Database Configuration
# ============================================================================
POSTGRES_USER=wardrobe
POSTGRES_PASSWORD=change-me-use-secure-password
POSTGRES_DB=wardrobe
POSTGRES_PORT=5432

# Redis Configuration
# ============================================================================
REDIS_PORT=6379

# Container User Configuration
# ============================================================================
# Run the app processes as a specific uid/gid so bind-mounted directories keep
# sane ownership on the host. When unset, defaults preserve the previous
# behavior (backend/worker: 1000, frontend: 1001). When set, all app
# containers run as the same PUID/PGID.
# PUID=1000
# PGID=1000

# Backend Configuration
# ============================================================================
BACKEND_PORT=8000
# SECRET_KEY: leave the value below unchanged for local development.
# Dev login (DEBUG=true) only activates when SECRET_KEY is exactly "change-me-in-production".
# For PRODUCTION, replace with a secure secret generated by: openssl rand -hex 32
SECRET_KEY=change-me-in-production
# Uncomment to enable dev credential login (no OIDC required). Requires the
# SECRET_KEY above to remain "change-me-in-production".
# WARNING: dev login lets ANYONE sign in as ANY email with no verification.
# Never enable it (DEBUG=true + default SECRET_KEY, or frontend DEV_MODE=true)
# on a deployment reachable from the internet.
# DEBUG=true

# Security headers
# ============================================================================
# SecurityHeadersMiddleware adds X-Frame-Options, X-Content-Type-Options,
# Referrer-Policy, Permissions-Policy, Cross-Origin-Resource-Policy, and a
# lock-down CSP (api-only; the Next.js frontend sets its own CSP for HTML).
# CSP is skipped for /docs, /redoc, /openapi.json so Swagger/ReDoc still work
# in DEBUG mode. Leave enabled unless you have a specific reason.
SECURITY_HEADERS_ENABLED=true
# HSTS is off by default so local HTTP/LAN development doesn't get pinned to
# HTTPS. ACTIVATE IN PRODUCTION — Cloudflare Tunnel always serves HTTPS.
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000

# Frontend Configuration
# ============================================================================
FRONTEND_PORT=3000
# If you rename the "backend" service in docker-compose.yml, set this to
# http://<your-service-name>:8000 so the frontend can still reach it.
# Replaces NEXT_PUBLIC_API_URL, which is still read as a fallback.
# BACKEND_URL=http://backend:8000
#
# When using docker-compose.prod.yml, nginx needs the renamed service too.
# BACKEND_HOST must match the service name; BACKEND_INTERNAL_PORT is the port
# inside the container (not BACKEND_PORT above, which is the published host port).
# BACKEND_HOST=backend
# BACKEND_INTERNAL_PORT=8000
NEXTAUTH_URL=http://localhost:3000
# IMPORTANT: Generate a secure secret for production
NEXTAUTH_SECRET=change-me-in-production-use-openssl-rand-hex-32
# Serving the app on more than one origin (e.g. LAN http://app.home AND public
# https://app.example.com behind a tunnel)? next-auth v4 otherwise pins every
# callback/redirect URL and the cookie Secure flag to NEXTAUTH_URL. With
# AUTH_TRUST_HOST=true it derives the origin per request from
# X-Forwarded-Host/X-Forwarded-Proto, so your reverse proxy MUST set those
# (and overwrite any client-supplied values). Note: the `trustHost` option in
# authOptions is Auth.js v5 only and is ignored by next-auth v4.
# Any non-empty value (even "false") enables it: leave it unset/empty to disable.
# AUTH_TRUST_HOST=true

# Canonical public URL, used by the backend for links in notifications,
# family invites and (unless MAGIC_LINK_BASE_URL is set) magic-link emails.
# APP_URL=https://app.example.com

# Authentication (OIDC Provider)
# ============================================================================
# Leave all empty to use development credential-based login (default)
# Choose ONE of the following authentication methods:

# Option 1: OIDC
# OIDC_ISSUER_URL=https://auth.example.com
# OIDC_CLIENT_ID=wardrobe
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_END_SESSION_URL=https://auth.example.com/api/oidc/end-session
# If your OIDC provider uses a private/internal CA, mount the CA cert into the
# container and set this to its path. TLS verification stays on; only the trust
# anchor changes. Do NOT disable TLS verification entirely.
# OIDC_CA_BUNDLE=/certs/internal-ca.pem

# Option 2: Forward Auth (TinyAuth, Authelia, etc.)
# AUTH_TRUST_PROXY=true

# Option 3: Magic link (Sprint 2, passwordless email via Resend)
# Coexiste con OIDC y dev-mode. Se activa cuando RESEND_API_KEY está definido.
# Works in production (DEBUG=false, DEV_MODE unset): the link opens
# /auth/callback, which signs in through the NextAuth "magic-link" provider
# (backend POST /api/v1/auth/magic-link/verify). Set MAGIC_LINK_ENABLED=false on
# the frontend to unregister that provider entirely.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=Miaurmario <hola@miaurmario.andreipop.org>
# Origin used in the emailed link (fixed config, never taken from the request
# Host header). Defaults to APP_URL.
# MAGIC_LINK_BASE_URL=https://miaurmario.andreipop.org

# Admin promotion (CSV de emails que se promocionan a role=admin al loguearse).
# Idempotente: si el email deja de estar en la lista, el user pasa a member en el próximo login.
# ADMIN_EMAILS=andrei@ejemplo.com

# Admin panel (/dashboard/admin) - all optional
# ============================================================================
# AI cost estimate defaults (editable later from Admin → Resumen; stored in
# app_settings). USD per 1M tokens (DeepSeek off-peak) + USD→EUR rate.
# AI_PRICE_INPUT_USD_PER_M=0.15
# AI_PRICE_OUTPUT_USD_PER_M=0.60
# USD_EUR_RATE=0.92
# AI_MONTHLY_BUDGET_EUR=5
# Backup status shown in Admin → Sistema. The backend container cannot see the
# host file by default: mount it read-only on the backend service, e.g.
#   volumes:
#     - /var/lib/backup-pop/last-backup.json:/run/backup-status.json:ro
# and set:
# BACKUP_STATUS_PATH=/run/backup-status.json
# Build identification (backend: shown in Admin → Sistema; frontend build arg
# NEXT_PUBLIC_BUILD_ID: attached to user feedback reports).
# APP_VERSION=2.1.0
# GIT_SHA=<commit sha>
# NEXT_PUBLIC_BUILD_ID=<commit sha>
# Spotify apps in development mode allow 5 users; shown as "x / 5 plazas".
# SPOTIFY_DEV_MODE_SLOTS=5
# Max size of feedback screenshots (MB).
# FEEDBACK_MAX_UPLOAD_MB=5

# DNS Configuration
# ============================================================================
# If your OIDC provider or other services use a local DNS hostname that
# Docker containers can't resolve, set this to your local DNS server IP:
# LOCAL_DNS=10.0.0.1

# AI Service Configuration
# ============================================================================
# Capability switches (optional). Defaults keep internal AI ON, so existing
# setups are unaffected. Set AI_INTERNAL_ENABLED=false to run with no internal
# AI at all — the app boots and serves without AI_BASE_URL/AI_API_KEY/models set,
# and tagging/suggestions/pairings are deferred to an external agent. The
# per-capability switches inherit the master when unset; an explicit value wins.
# Check effective state at GET /api/v1/capabilities.
# AI_INTERNAL_ENABLED=true     # master switch
# AI_VISION_ENABLED=true       # internal auto-tagging (inherits master if unset)
# AI_TEXT_ENABLED=true         # internal suggestions/pairings (inherits master if unset)
#
# The provider settings below are only REQUIRED when internal AI is enabled.
# ============================================================================
# Choose ONE of the following AI providers
# The app needs a vision model (for analyzing clothing images) and a text model (for recommendations)
# ============================================================================

# Option 1: Ollama (Recommended - FREE, runs locally, no API key needed)
# ============================================================================
# 1. Install Ollama from https://ollama.ai
# 2. Pull required models:
#    ollama pull llava:7b      # Vision model for image analysis
#    ollama pull gemma3        # Text model for recommendations
#    (Alternative text models: llama3, qwen2.5, mistral)
# 3. Use this configuration:
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_API_KEY=not-needed
AI_VISION_MODEL=llava:7b
AI_TEXT_MODEL=gemma3:latest

# Timeout and retry settings
# ============================================================================
# AI_TIMEOUT: how long (seconds) the backend waits for a single LLM response.
# Slow local models often need 300-600s. Worst-case request time = AI_TIMEOUT * AI_MAX_RETRIES.
# AI_TIMEOUT=120
# AI_MAX_RETRIES=3
#
# NGINX_AI_TIMEOUT: how long nginx waits for a backend response on AI endpoints.
# Must be >= AI_TIMEOUT * AI_MAX_RETRIES. Only relevant when using docker-compose.prod.yml.
# NGINX_AI_TIMEOUT=600

# Option 2: OpenAI (Paid API - requires API key)
# ============================================================================
# Uncomment these lines and comment out the Ollama config above:
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-your-api-key-here
# AI_VISION_MODEL=gpt-4o
# AI_TEXT_MODEL=gpt-4o

# Option 3: LocalAI (Self-hosted OpenAI alternative)
# ============================================================================
# AI_BASE_URL=http://localai:8080/v1
# AI_API_KEY=not-needed
# AI_VISION_MODEL=gpt-4-vision-preview
# AI_TEXT_MODEL=gpt-3.5-turbo

# Option 4: Azure OpenAI
# ============================================================================
# AI_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment/
# AI_API_KEY=your-azure-api-key
# AI_VISION_MODEL=gpt-4o
# AI_TEXT_MODEL=gpt-4o

# Notification Providers (all optional)
# ============================================================================
# Default channels (no user setup needed):
# - Email to the account address for friend requests, accepted requests and
#   the scheduled daily outfit. Sent through Resend (RESEND_API_KEY above),
#   falling back to SMTP_* below. Every email carries a signed one-click
#   unsubscribe link + List-Unsubscribe header (signed with SECRET_KEY, so the
#   worker needs the same SECRET_KEY, RESEND_* and MAGIC_LINK_BASE_URL).
# - Web Push ("Este dispositivo") once a user enables it on a device. Needs a
#   VAPID key pair, set on BOTH backend and worker. Generate it once with:
#     docker compose exec backend python scripts/generate_vapid_keys.py
#   (or: npx web-push generate-vapid-keys). Rotating the keys drops every
#   existing browser subscription. Leave empty to hide the push channel.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@andreipop.org

# ntfy.sh push notifications
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Mattermost webhook
MATTERMOST_WEBHOOK_URL=

# Email notifications over SMTP (fallback when RESEND_API_KEY is unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Music enrichment for the Stylist (optional)
# ============================================================================
# Enables the "¿Qué escuchas hoy?" input on /dashboard/suggest — the Stylist
# uses Last.fm mood/emotion tags (and MusicBrainz as fallback) to shape the
# outfit around the song. Leave empty to disable enrichment; the song input
# still works and passes the raw text to the LLM.
# Get a free API key at https://www.last.fm/api/account/create
#
# The same key is the Música tab's source for everyone without Spotify:
# users enter their Last.fm username (Spotify → Last.fm scrobbling works for
# any Spotify account) and a worker cron syncs user.getRecentTracks every
# 15 min. Requests are throttled with a Redis token bucket shared by the API
# and the worker (Last.fm allows ~5 req/s per IP).
LASTFM_API_KEY=
# Optional: the app's shared secret enables "Iniciar sesión con Last.fm"
# (web auth, auth.getSession) as an alternative to typing the username.
# Callback registered in the Last.fm app (any URL on this host works):
LASTFM_API_SECRET=
LASTFM_CALLBACK_URL=https://miaurmario.andreipop.org/api/v1/integrations/lastfm/callback
# Token bucket rate (requests/second, whole deployment). Keep below 5.
LASTFM_REQUESTS_PER_SECOND=4

# Adding a garment from a pasted shop link
# ============================================================================
# The backend fetches the product page itself and reads the OpenGraph /
# JSON-LD metadata the shop already publishes (name, brand, price, colour and
# the main photo). It never runs the page's JavaScript, only follows https,
# refuses any host that resolves to a private/loopback/link-local address
# (including the cloud metadata IP), caps the download and pins the connection
# to the address it checked. Set to false to turn the feature off entirely;
# the add form then falls back to photo + manual entry.
LINK_IMPORT_ENABLED=true
# Sent to the shops we read, so they can see who is knocking (keep the URL).
LINK_IMPORT_USER_AGENT=Miaurmario/1.0 (+https://github.com/andreipopx/miaurmario; wardrobe link preview)

# Third-party integrations (Pinterest, Spotify)
# ============================================================================
# OAuth tokens are stored Fernet-encrypted. One key covers every integration.
# Generate it with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key invalidates all stored tokens (users simply re-connect).
# (PINTEREST_TOKEN_ENCRYPTION_KEY is still accepted as a legacy fallback.)
INTEGRATIONS_TOKEN_ENCRYPTION_KEY=

# After the OAuth callback the browser is sent to MAGIC_LINK_BASE_URL + the
# settings page (see "Option 3: Magic link" above). If MAGIC_LINK_BASE_URL is
# unset, a relative redirect is used. It is never derived from the Host header.

# Pinterest — https://developers.pinterest.com/apps/ (scopes: boards:read,pins:read)
# The redirect URI registered in the Pinterest app must match exactly (HTTPS).
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=https://miaurmario.andreipop.org/api/v1/integrations/pinterest/callback

# Spotify — https://developer.spotify.com/dashboard (Web API)
# Scopes: user-read-recently-played user-read-currently-playing user-top-read
# Development Mode apps only work for allowlisted accounts (User Management).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://miaurmario.andreipop.org/api/v1/integrations/spotify/callback
