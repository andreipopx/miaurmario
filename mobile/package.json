{
  "name": "miaurmario-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Miaurmario for Android and iOS: a Capacitor shell around the web app.",
  "scripts": {
    "sync": "cap sync",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor '#FFFFFF' --splashBackgroundColor '#FFFFFF' --iconBackgroundColorDark '#FFFFFF' --splashBackgroundColorDark '#0F0F0F'",
    "android:apk": "cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "cap sync android && cd android && ./gradlew bundleRelease assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "typescript": "^5.7"
  }
}
