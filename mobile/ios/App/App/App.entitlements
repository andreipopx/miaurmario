<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (APNs). Xcode switches it to "production" when exporting for the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links (magic link, invites) and saved passwords for the site. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:miaurmario.andreipop.org</string>
		<string>webcredentials:miaurmario.andreipop.org</string>
	</array>
</dict>
</plist>
